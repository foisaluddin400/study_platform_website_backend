# ==============================================================================
# AbroadPath OS Backend - Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (MongoDB Atlas Cluster0)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/study_abroad_platform?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_minimum_16_characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_minimum_16_characters
JWT_REFRESH_EXPIRES_IN=30d

# CORS Allowed Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ==============================================================================
# Email & SMTP Configuration (Production Ready)
# ==============================================================================
# Set your real email provider credentials below.
#
# Option A: Gmail SMTP (Requires a Google App Password)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-address@gmail.com
#   SMTP_PASS=your-16-char-app-password
#
# Option B: SendGrid SMTP
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=apikey
#   SMTP_PASS=SG.your_sendgrid_api_key
#
# Option C: Amazon SES SMTP
#   SMTP_HOST=email-smtp.us-east-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your_ses_smtp_username
#   SMTP_PASS=your_ses_smtp_password
#
# Option D: Custom SMTP / cPanel / Zoho / Outlook
#   SMTP_HOST=mail.yourdomain.com
#   SMTP_PORT=465 (or 587)
#   SMTP_SECURE=true (true for 465, false for 587)
#   SMTP_USER=no-reply@yourdomain.com
#   SMTP_PASS=your_email_password
# ==============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=no-reply@abroadpath.com
EMAIL_FROM_NAME=AbroadPath OS
